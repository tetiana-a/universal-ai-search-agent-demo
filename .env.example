# ============================================================
# AURELIUS — ZERO-COST / LOCAL-FIRST MODE
# No paid AI/search APIs are required.
# Telegram itself uses the free Telegram Bot API.
# ============================================================

ZERO_COST_MODE=on
RESEARCH_AI_PROVIDER=free

# Keyless web search.
# DuckDuckGo HTML/Lite is used without an API key.
# Optional: point SEARXNG_URL to your own self-hosted SearXNG.
KEYLESS_SEARCH=always
KEYLESS_SEARCH_PAUSE_MS=500
SEARXNG_URL=

# Read public pages directly when allowed by robots/policy.
DIRECT_READ=on

# Optional fully-local AI through Ollama.
# If empty, AURELIUS still works with deterministic extraction + manual review.
# Example after installing Ollama:
#   ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Disable extra paid/provider search calls in zero-cost mode.
SUPPLEMENTAL_SEARCH_ENABLED=false
SUPPLEMENTAL_SEARCH_MAX_QUERIES=0

# Hosted AI/search providers are intentionally blank in zero-cost mode.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
JINA_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
MOJEEK_API_KEY=
YANDEX_SEARCH_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
FIRECRAWL_API_KEY=
SERPER_API_KEY=

# ------------------------------------------------------------
# Telegram control center
# Create a bot with @BotFather. The token is free.
# Never commit your real token.
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
SCOUT_ADMIN_TELEGRAM_IDS=
SCOUT_REPORT_CHAT_ID=

# Local polling means you do NOT need a public webhook or paid hosting.
# Run Next.js locally, then run: npm run telegram:poll
LOCAL_BOT_WEBHOOK_URL=http://127.0.0.1:3000/api/scout/telegram
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Persistence
# Local JSON storage keeps tasks, sources, leads, settings and learning between restarts.
# This is the default zero-cost persistence for a single-machine deployment.
LOCAL_STORE_DIR=.aurelius-data

# Optional cloud persistence can be configured later.
# ------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email delivery is optional and disabled in zero-cost mode.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_ALLOWED_RECIPIENTS=

# Local/internal mode: no artificial Free/Pro quota.
PLAN_ENFORCEMENT=off
DEFAULT_PLAN=free
PRO_ACCESS_KEYS=
FREE_DAILY_TASKS=100
PRO_DAILY_TASKS=100
QUOTA_SALT=local_only_change_me

FREE_AI_TIMEOUT_MS=30000
RESEARCH_MAX_DURATION_SECONDS=300
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
