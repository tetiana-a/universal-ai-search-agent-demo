# Primary live research provider
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.6-sol

# Optional supplemental search providers. The app uses these only server-side.
# If configured, they expand discovery before the primary OpenAI web research pass.
BRAVE_SEARCH_API_KEY=your_brave_key_here
EXA_API_KEY=your_exa_key_here
TAVILY_API_KEY=your_tavily_key_here
MOJEEK_API_KEY=your_mojeek_key_here
YANDEX_SEARCH_API_KEY=your_yandex_search_api_key_here
YANDEX_SEARCH_API_URL=https://searchapi.api.cloud.yandex.net/v2/web/search
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password
DATAFORSEO_LOCATION_CODE=your_location_code

# Reserved for the next acquisition adapters in production.
JINA_API_KEY=your_jina_key_here
FIRECRAWL_API_KEY=your_firecrawl_key_here
SERPER_API_KEY=your_serper_key_here

# Safety / operations defaults
SUPPLEMENTAL_SEARCH_ENABLED=true
# Max query branches sent to configured supplemental providers. Higher = more recall and higher cost.
SUPPLEMENTAL_SEARCH_MAX_QUERIES=8
SUPPLEMENTAL_SEARCH_TIMEOUT_MS=18000
RESEARCH_MAX_DURATION_SECONDS=300
