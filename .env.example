# Research AI provider: free avoids OpenAI billing.
RESEARCH_AI_PROVIDER=free

# Free hosted AI via OpenRouter. The free router charges $0 for free-model requests.
OPENROUTER_API_KEY=your_openrouter_free_key_here
OPENROUTER_MODEL=openrouter/free

# Jina Search/Reader. REQUIRED for free mode search: s.jina.ai rejects requests without a key.
# Without it (and without any fallback provider below) research returns HTTP 503 JINA_API_KEY_MISSING.
JINA_API_KEY=your_jina_free_key_here

# Optional search providers. Any configured one is used automatically as a fallback when
# Jina fails, is rate limited or finds fewer than 5 candidates.
OPENAI_API_KEY=
OPENAI_MODEL=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
MOJEEK_API_KEY=
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_API_URL=https://searchapi.api.cloud.yandex.net/v2/web/search
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=
FIRECRAWL_API_KEY=
SERPER_API_KEY=

# Persistent memory / learning (server-side). Use Upstash Redis REST or Vercel KV REST credentials.
# Never expose the write token to the browser.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Equivalent Upstash names are also supported:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional automatic Telegram delivery after an explicit user action remains disabled by default.

# Direct Telegram bot delivery (no n8n required).
# Store the token only in Vercel as a Secret; never commit the real token.
TELEGRAM_BOT_TOKEN=
# Real recipient chat IDs, not the bot's own Telegram user ID.
TELEGRAM_CHAT_ID=
# Optional comma-separated allowlist for additional users/groups/channels.
TELEGRAM_ALLOWED_CHAT_IDS=

# Transactional email delivery via Resend.
# Sender must be a verified address/domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Comma-separated recipients allowed to use the in-app send button.
EMAIL_ALLOWED_RECIPIENTS=

# Research/search controls
# true = always query fallback providers in addition to Jina (more recall, more API cost).
SUPPLEMENTAL_SEARCH_ENABLED=false
SUPPLEMENTAL_SEARCH_MAX_QUERIES=3
SUPPLEMENTAL_SEARCH_TIMEOUT_MS=7000
# Capped automatically so the whole task fits the 60 s function limit.
FREE_AI_TIMEOUT_MS=30000
NEXT_PUBLIC_SITE_URL=https://universal-ai-search-agent-demo.vercel.app

# Legacy paid-mode timeouts
OPENAI_RESEARCH_TIMEOUT_MS=120000
OPENAI_RETRY_TIMEOUT_MS=25000
RESEARCH_MAX_DURATION_SECONDS=300

# Plans (Free / Pro). See docs/PLANS_AND_BILLING.md.
# on (default) = limits enforced; off = everything unlimited (internal demo).
PLAN_ENFORCEMENT=on
# Plan for requests without a valid Pro key: free | pro
DEFAULT_PLAN=free
# Comma-separated Pro access keys (min 12 chars each). Users paste one in Settings → Plan.
PRO_ACCESS_KEYS=
FREE_DAILY_TASKS=5
PRO_DAILY_TASKS=100
# Salt for hashing client IPs in quota counters.
QUOTA_SALT=change_me
