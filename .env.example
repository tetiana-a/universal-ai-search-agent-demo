# ============================================================
# AURELIUS — ZERO-COST CLOUD MODE (Vercel)
# No paid AI/search API is required.
# Telegram itself uses the free Telegram Bot API.
# ============================================================

ZERO_COST_MODE=on
RESEARCH_AI_PROVIDER=free

# Keyless web search.
KEYLESS_SEARCH=always
KEYLESS_SEARCH_PAUSE_MS=500
SEARXNG_URL=
DIRECT_READ=on

# Free cloud AI. Requires a free OpenRouter account/key, but the selected router is zero-priced.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Keep paid/optional providers blank in strict zero-cost mode.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
JINA_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
MOJEEK_API_KEY=
YANDEX_SEARCH_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
FIRECRAWL_API_KEY=
SERPER_API_KEY=

# ------------------------------------------------------------
# Cloud persistence — Upstash Redis Free tier.
# Use either the KV_* names or the UPSTASH_* names.
# ------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# Telegram control center
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
SCOUT_ADMIN_TELEGRAM_IDS=
SCOUT_REPORT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Shared-group mode: every human member of the report group can use commands/buttons.
# If TELEGRAM_OPEN_GROUP_IDS is empty, SCOUT_REPORT_CHAT_ID is used automatically.
TELEGRAM_OPEN_GROUP_ACCESS=off
TELEGRAM_OPEN_GROUP_IDS=

# Dashboard access.
# on = anyone with the /scout link can read/write the shared workspace.
SCOUT_PUBLIC_DASHBOARD=off
# Used only when SCOUT_PUBLIC_DASHBOARD is off.
SCOUT_ADMIN_KEY=

# Optional email delivery.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_ALLOWED_RECIPIENTS=

# Internal/free mode.
PLAN_ENFORCEMENT=off
DEFAULT_PLAN=free
PRO_ACCESS_KEYS=
FREE_DAILY_TASKS=100
PRO_DAILY_TASKS=100
QUOTA_SALT=change_me

FREE_AI_TIMEOUT_MS=30000
RESEARCH_MAX_DURATION_SECONDS=300
NEXT_PUBLIC_SITE_URL=https://universal-ai-search-agent-demo.vercel.app

# ------------------------------------------------------------
# Optional LOCAL mode only — do not set these on Vercel.
# ------------------------------------------------------------
LOCAL_STORE_DIR=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
