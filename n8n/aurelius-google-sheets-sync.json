{
  "name": "AURELIUS — Google Sheets CRM mirror (manual, safe)",
  "nodes": [
    {
      "id": "start",
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        180,
        350
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "get-groups",
      "name": "Read AURELIUS groups",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        420,
        160
      ],
      "parameters": {
        "method": "GET",
        "url": "https://universal-ai-search-agent-demo.vercel.app/api/groups",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "get-campaigns",
      "name": "Read AURELIUS campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        420,
        570
      ],
      "parameters": {
        "method": "GET",
        "url": "https://universal-ai-search-agent-demo.vercel.app/api/campaigns",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "map-Groups",
      "name": "Map Groups",
      "type": "n8n-nodes-base.code",
      "position": [
        750,
        80
      ],
      "parameters": {
        "jsCode": "const f=(x)=>{const s=String(x??'').slice(0,1500);return /^[=+@-]/.test(s)?'\\''+s:s;};\nconst r=$input.first().json;\nif(!r || r.ok!==true) throw new Error('AURELIUS API not authorized');\nconst a=Array.isArray(r.groups)?r.groups:[];\nreturn a.map(g=>({id:f(g.id),url:f(g.url),name:f(g.name),platform:f(g.platform),city:f(g.city),country:f(g.country),status:f(g.status),ads:f(g.ads),members:Number(g.members||0),botConnected:!!g.botConnected,postingEnabled:!!g.postingEnabled,updatedAt:f(g.updatedAt)})).map(x=>({json:x}));"
      },
      "typeVersion": 2
    },
    {
      "id": "sheet-Groups",
      "name": "Sheets Groups",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1050,
        80
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Groups",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.id }}",
            "url": "={{ $json.url }}",
            "name": "={{ $json.name }}",
            "platform": "={{ $json.platform }}",
            "city": "={{ $json.city }}",
            "country": "={{ $json.country }}",
            "status": "={{ $json.status }}",
            "ads": "={{ $json.ads }}",
            "members": "={{ $json.members }}",
            "botConnected": "={{ $json.botConnected }}",
            "postingEnabled": "={{ $json.postingEnabled }}",
            "updatedAt": "={{ $json.updatedAt }}"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": []
        },
        "options": {}
      },
      "typeVersion": 4.5
    },
